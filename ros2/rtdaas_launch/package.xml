<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rtdaas_launch</name>
  <version>0.1.0</version>
  <description>
    Launch files for the rtdaas telemetry fleet: N simulated dVRK robots (kinematic
    simulation, no hardware), the rtdaas adapter nodes and one kafka_bridge per robot.
  </description>
  <maintainer email="tom.oconn3ll@gmail.com">Thomas O'Connell</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rtdaas_adapters</exec_depend>
  <exec_depend>rtdaas_kafka_bridge</exec_depend>
  <exec_depend>rtdaas_msgs</exec_depend>
  <!-- dVRK kinematic simulation (jhu-dvrk/dvrk-ros2); see ros2/README.md for the workspace setup. -->
  <exec_depend>dvrk_model</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
