<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rtdaas_adapters</name>
  <version>0.1.0</version>
  <description>
    Adapter nodes that turn raw dVRK topics into the rtdaas telemetry contract:
    tool_pose_adapter (measured_cp + jaw -> rtdaas_msgs/ToolPose) and
    fleet_monitor (operating states + joint limits -> Heartbeat / SystemEvent).
  </description>
  <maintainer email="tom.oconn3ll@gmail.com">Thomas O'Connell</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>rtdaas_msgs</depend>
  <!-- crtk_msgs comes with the dVRK ROS 2 stack; the monitor degrades gracefully without it. -->
  <exec_depend condition="$ROS_DISTRO != ''">crtk_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
