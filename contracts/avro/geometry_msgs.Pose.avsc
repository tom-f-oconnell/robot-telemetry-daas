{
  "type": "record",
  "name": "Pose",
  "namespace": "geometry_msgs",
  "doc": "Generated from ROS 2 message geometry_msgs/Pose.",
  "fields": [
    {
      "name": "position",
      "type": {
        "type": "record",
        "name": "Point",
        "namespace": "geometry_msgs",
        "doc": "Generated from ROS 2 message geometry_msgs/Point.",
        "fields": [
          {
            "name": "x",
            "type": "double",
            "doc": "This contains the position of a point in free space"
          },
          {
            "name": "y",
            "type": "double"
          },
          {
            "name": "z",
            "type": "double"
          }
        ]
      },
      "doc": "A representation of pose in free space, composed of position and orientation."
    },
    {
      "name": "orientation",
      "type": {
        "type": "record",
        "name": "Quaternion",
        "namespace": "geometry_msgs",
        "doc": "Generated from ROS 2 message geometry_msgs/Quaternion.",
        "fields": [
          {
            "name": "x",
            "type": "double",
            "doc": "This represents an orientation in free space in quaternion form.",
            "default": 0.0
          },
          {
            "name": "y",
            "type": "double",
            "default": 0.0
          },
          {
            "name": "z",
            "type": "double",
            "default": 0.0
          },
          {
            "name": "w",
            "type": "double",
            "default": 1.0
          }
        ]
      }
    }
  ]
}
