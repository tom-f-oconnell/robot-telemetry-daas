# Copy to .env (same directory) and adjust. All variables mirror
# docs/architecture/spec.md §9; compose passes the in-cluster hostnames to
# containers, these are mostly secrets, sizing and image selection.

# ---- images -----------------------------------------------------------------
RTDAAS_IMAGE_PREFIX=rtdaas          # or ghcr.io/<owner>/rtdaas to pull CI-built images
RTDAAS_IMAGE_TAG=dev

# ---- object storage (MinIO) -------------------------------------------------
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_RAW=rtdaas-raw
S3_BUCKET_LAKE=rtdaas-lake

# ---- Airflow ----------------------------------------------------------------
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=airflow
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=rtdaas-dev-secret

# ---- Snowflake (optional; publish falls back to DuckDB when unset) ---------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=RTDAAS
SNOWFLAKE_ROLE=

# ---- serving ----------------------------------------------------------------
SERVING_BACKEND=duckdb              # sqlite | duckdb
LOG_LEVEL=INFO

# ---- Spark sizing -----------------------------------------------------------
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_CORES=2

# ---- demo simulator ---------------------------------------------------------
SIM_ROBOTS=3
SIM_DURATION_S=600
SIM_RATE_HZ=50

# ---- observability ----------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ---- for host-side CLIs (rtdaas-sim / rtdaas-api run from the host) --------
# KAFKA_BOOTSTRAP=localhost:29092
# SCHEMA_REGISTRY_URL=http://localhost:8081/apis/ccompat/v7
# ES_URL=http://localhost:9200
# S3_ENDPOINT=http://localhost:9000
# ICEBERG_REST_URI=http://localhost:8181
# ICEBERG_WAREHOUSE=s3a://rtdaas-lake/warehouse
# AIRFLOW_API_URL=http://localhost:8085/api/v1
