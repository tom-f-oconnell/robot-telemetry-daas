# Generated by terraform (infra/terraform/envs/aws). Do not edit by hand.
[k3s_server]
${server_name} ansible_host=${server_ip} private_ip=${server_priv}

[k3s_agent]
%{ for a in agents ~}
${a.name} ansible_host=${a.ip} private_ip=${a.priv}
%{ endfor ~}

[k3s_cluster:children]
k3s_server
k3s_agent

[all:vars]
ansible_user=${ssh_user}
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new'
rtdaas_s3_bucket_raw=${bucket_raw}
rtdaas_s3_bucket_lake=${bucket_lake}
rtdaas_aws_region=${region}
rtdaas_cloud=aws
